<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 广告需要联网；其余敏感权限一律不要 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      广告 SDK 的清单会合并进来一批敏感权限。本游戏用不到，
      也为了避免上架审核被点名「超范围收集」，这里逐条显式移除。
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:node="remove" />

    <application
        android:allowBackup="false"
        tools:replace="android:allowBackup,android:supportsRtl"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.FishingLife">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize"
            android:theme="@style/Theme.FishingLife">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          隐私合规（审核检测点：同意前不得读取设备标识）：
          下面这些第三方 SDK 的 ContentProvider 会在**进程启动时自动初始化**，
          早于隐私政策弹窗，因此会在用户同意前读取 AndroidID / OAID 等标识。
          全部移除 —— 各 SDK 改为在用户点「同意」之后由我们的代码显式初始化：
            · TapTap 登录 / 防沉迷 -> MainActivity.setupTap()（TapTapSdk.init 内部会跑
              TapTapSdkInitializer，与 TapTapKitInitProvider 做的事完全一致）
            · 广告聚合 Tosin -> MainActivity.setupAds()（TosinSDK.instance.init）
          只移除「初始化 / 常驻服务」类 provider；各家的 FileProvider 保留不动。
        -->
        <provider android:name="com.taptap.sdk.kit.internal.TapTapKitInitProvider" tools:node="remove" />
        <provider android:name="com.taptap.sdk.themis.lite.ThemisProvider" tools:node="remove" />
        <provider android:name="com.anythink.core.api.ATInitializationProvider" tools:node="remove" />
        <provider android:name="com.smartdigimkt.sdk.api.SDMInitializationProvider" tools:node="remove" />
        <provider android:name="com.byazt.yx.TTMultiProvider" tools:node="remove" />
        <provider android:name="com.byazt.hii.MainProcessProviderProxy" tools:node="remove" />
        <provider android:name="com.byazt.hh.MainServerManager" tools:node="remove" />
        <provider android:name="com.byazt.ozr.MainServerManager" tools:node="remove" />
        <provider android:name="com.byazt.hh.DownloaderServerManager" tools:node="remove" />
        <provider android:name="com.bytedance.android.openliveplugin.process.server.LiveServerManager" tools:node="remove" />
        <provider android:name="com.byted.live.lite.ServerManager_bytelive" tools:node="remove" />
        <provider android:name="com.byted.live.lite.ServerManager_push" tools:node="remove" />
        <provider android:name="com.byted.live.lite.ServerManager_downloader" tools:node="remove" />
    </application>

</manifest>
