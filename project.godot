[internationalization]

locale/translations=PackedStringArray("res://localization/localized_misc.de.translation", "res://localization/localized_misc.en.translation", "res://localization/localized_purchasables.de.translation", "res://localization/localized_purchasables.en.translation", "res://localization/localized_shop.de.translation", "res://localization/localized_shop.en.translation", "res://localization/localized_options.de.translation", "res://localization/localized_options.en.translation", "res://localization/localized_stats_overview.de.translation", "res://localization/localized_stats_overview.en.translation")

[layer_names]

2d_physics/layer_1="coins"
2d_physics/layer_2="helper"

[physics]

common/physics_ticks_per_second=20
common/physics_jitter_fix=0.0
common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
